@model _1_Calculator.Models.CalculatorViewModel
@{
    ViewData["Title"] = "Калькулятор";
}
<h2>@ViewData["Title"]</h2>
<form asp-controller="Calculator" asp-action="Calculate" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="Num1" class="form-label">Первое число</label>
        <input asp-for="Num1" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Operation" class="form-label">Операция</label>
        <select asp-for="Operation" class="form-select">
            <option value="Add">+</option>
            <option value="Subtract">-</option>
            <option value="Multiply">*</option>
            <option value="Divide">/</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Num2" class="form-label">Второе число</label>
        <input asp-for="Num2" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Посчитать</button>
</form>
@if (!string.IsNullOrWhiteSpace(Model?.ErrorMessage))
{
    <div class="text-danger mt-3">@Model.ErrorMessage</div>
}
@if (Model?.Result != null)
{
    <h3 class="mt-3">Результат: @Model.Result</h3>
}


